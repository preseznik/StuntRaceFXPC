<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StuntRaceFX.Launcher</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Modern/Fonts/BarlowCondensed-BoldItalic.ttf" />
    <Resource Include="Modern/Fonts/OFL.txt" />
    <Using Include="System.IO" />
    <None Update="Classic Launcher.cmd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Modern/Fonts/OFL.txt" Link="licenses/BarlowCondensed-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_RuntimeNotice Include="%(ResolvedRuntimePack.PackageDirectory)/LICENSE*;%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES*"
                      Condition="'%(ResolvedRuntimePack.PackageDirectory)' != ''">
        <Pack>%(ResolvedRuntimePack.NuGetPackageId)</Pack>
      </_RuntimeNotice>
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeNotice)"
          DestinationFiles="@(_RuntimeNotice->'$(PublishDir)licenses/%(Pack)/%(Filename)%(Extension)')" />
  </Target>
</Project>
